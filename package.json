{
  "name": "@paranod/plugin-sdk",
  "version": "0.4.0",
  "description": "TypeScript SDK for external addons for the open-source Paranod OSINT framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "paranod",
    "osint",
    "plugin",
    "sdk",
    "external-plugin"
  ],
  "author": "PARANOD Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstlgu/paranod-addon-sdk.git"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.12",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "qs": "^6.17.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  },
  "homepage": "https://github.com/rstlgu/paranod-addon-sdk#readme",
  "bugs": {
    "url": "https://github.com/rstlgu/paranod-addon-sdk/issues"
  }
}
